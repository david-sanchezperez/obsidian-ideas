TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Vía LiteLLM (puerta única de modelos). Los defaults ya apuntan a la sobremesa
# (192.168.1.32:4000) con la master key local — solo hace falta sobreescribir
# si LiteLLM vive en otro sitio.
LITELLM_URL=http://192.168.1.32:4000/v1/chat/completions
LITELLM_API_KEY=sk-litellm-local

# Detección de encaje -> tarea autónoma en un orquestador tipo agent-loops
# (rama task/<id>, nunca a main). Opcional: sin esto, el bot solo resume y guarda.
AGENT_LOOPS_URL=
# Webhook en el host que abre el PR/MR cuando la tarea termina; opcional
PR_CALLBACK_URL=

# docker-compose.yml: dónde vive tu vault de Obsidian en el host, y con qué
# UID:GID debe correr el contenedor para poder escribir ahí
VAULT_HOST_PATH=/path/to/your/obsidian-vault
USER_UID=1000
USER_GID=1000

# Panel de solo lectura del vault (servicio "dashboard" en docker-compose.yml),
# puerto expuesto en el host
DASHBOARD_PORT=8788
