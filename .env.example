TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USERS=
DEEPSEEK_API_KEY=

# Detección de encaje -> tarea autónoma en un orquestador tipo agent-loops
# (rama task/<id>, nunca a main). Opcional: sin esto, el bot solo resume y guarda.
AGENT_LOOPS_URL=
# Webhook en el host que abre el PR/MR cuando la tarea termina; opcional
PR_CALLBACK_URL=

# docker-compose.yml: dónde vive tu vault de Obsidian en el host, y con qué
# UID:GID debe correr el contenedor para poder escribir ahí
VAULT_HOST_PATH=/path/to/your/obsidian-vault
USER_UID=1000
USER_GID=1000
